/* --- GLOBAL --- */
QWidget {
    background-color: {{background}};
    color: {{foreground}};
    font-family: "Segoe UI", "Roboto", "Helvetica Neue", sans-serif;
    font-size: 14px;
}

/* --- HEADINGS & LABELS --- */
QLabel {
    color: {{foreground}};
}
QLabel[class="heading"] {
    font-size: 18px;
    font-weight: bold;
    color: {{primary}};
    margin-bottom: 8px;
}
QLabel[class="subheading"] {
    color: {{foreground_muted}};
    font-weight: 600;
}

/* --- GROUP BOX (Cards y GroupBox con bordes sutiles) --- */
QGroupBox {
    background-color: {{surface}};
    border: 1px solid {{border}};
    border-radius: 12px;
    
    /* Margen EXTERNO (separación con otros elementos de arriba) */
    margin-top: 8px;
    
    /* Padding INTERNO SUPERIOR grande para dejar sitio al título */
    padding-top: 35px; 
    padding-left: 16px;
    padding-right: 16px;
    padding-bottom: 16px;

    font-weight: bold;
    color: {{primary}};
}

QGroupBox::title {
    /* CLAVE: 'padding' coloca el título DENTRO del borde, no encima */
    subcontrol-origin: margin;
    subcontrol-position: top left;
    
    /* Ajustamos la posición para que quede en la esquina superior izquierda interna */
    padding: 4px 8px;
    
    /* Al estar dentro, ya puede ser transparente y tomará el color de {{surface}} */
    background-color: transparent;
    color: {{foreground_muted}};
    font-weight: 600;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* --- INPUTS Y FORMULARIOS --- */
QLineEdit, QTextEdit, QDateEdit, QSpinBox, QDoubleSpinBox {
    background-color: {{surface_alt}};
    border: 1px solid {{border}};
    border-radius: 6px;
    padding: 8px 12px;
    color: {{foreground}};
    min-height: 20px;
    max-height: 32px;
    selection-background-color: {{selection_bg}};
    selection-color: {{selection_text}};
}

QLineEdit:focus, QTextEdit:focus, QDateEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid {{primary}};
    background-color: {{surface}};
}

/* --- COMBOBOX - CRÍTICO: Estilos completos para dropdown --- */
QComboBox {
    background-color: {{surface_alt}};
    border: 1px solid {{border}};
    border-radius: 6px;
    padding: 8px 12px;
    padding-right: 32px;  /* Espacio para la flecha */
    color: {{foreground}};
    min-height: 20px;
    max-height: 32px;
    selection-background-color: {{selection_bg}};
    selection-color: {{selection_text}};
}

QComboBox:hover {
    border: 1px solid {{border_focus}};
}

QComboBox:focus {
    border: 2px solid {{primary}};
    background-color: {{surface}};
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 1px solid {{border}};
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: transparent;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid {{foreground_muted}};
    margin-right: 6px;
}

QComboBox::down-arrow:hover {
    border-top-color: {{foreground}};
}

/* CRÍTICO: Estilos del dropdown desplegable */
QComboBox QAbstractItemView {
    background-color: {{surface}};
    border: 1px solid {{border}};
    border-radius: 6px;
    selection-background-color: {{selection_bg}};
    selection-color: {{selection_text}};
    color: {{foreground}};
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-radius: 4px;
    min-height: 24px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: {{surface_alt}};
    color: {{foreground}};
}

QComboBox QAbstractItemView::item:selected {
    background-color: {{selection_bg}};
    color: {{selection_text}};
}

/* --- BUTTONS --- */
QPushButton {
    background-color: {{surface}};
    border: 1px solid {{border}};
    border-radius: 6px;
    padding: 8px 16px;
    color: {{foreground}};
    font-weight: 500;
    min-height: 28px;
    max-height: 36px;
}

QPushButton:hover {
    background-color: {{surface_alt}};
    border-color: {{primary_hover}};
}

QPushButton:pressed {
    background-color: {{border}};
}

QPushButton:disabled {
    background-color: {{surface_alt}};
    color: {{foreground_disabled}};
    border-color: {{border}};
}

/* Primary Action Button (Guardar, etc) */
QPushButton[class="primary"] {
    background-color: {{primary}};
    color: {{primary_text}};
    border: 1px solid {{primary}};
    font-weight: 600;
    min-height: 28px;
    max-height: 36px;
}

QPushButton[class="primary"]:hover {
    background-color: {{primary_hover}};
    border-color: {{primary_hover}};
}

/* Action Icon Button (Tablas) */
QPushButton#actionButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px;
}

QPushButton#actionButton:hover {
    background-color: {{selection_bg}};
}

/* --- TABLES --- */
/* Note: QTableView is included alongside QTableWidget for compatibility,
   as some parts of the app may use QTableView directly or through inheritance */
QTableWidget, QTableView {
    background-color: {{surface}};
    alternate-background-color: {{surface_alt}};
    gridline-color: {{table_grid}};
    border: 1px solid {{border}};
    border-radius: 6px;
    selection-background-color: {{selection_bg}};
    selection-color: {{selection_text}};
}
QHeaderView::section {
    background-color: {{table_header_bg}};
    color: {{foreground_muted}};
    padding: 8px 12px;
    border: none;
    border-bottom: 2px solid {{border}};
    font-weight: bold;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.5px;
}
QTableWidget::item, QTableView::item {
    padding: 6px;
    background-color: {{surface}};
    color: {{foreground}};
}
QTableWidget::item:alternate, QTableView::item:alternate {
    background-color: {{surface_alt}};
}
QTableWidget::item:selected, QTableView::item:selected {
    background-color: {{selection_bg}};
    color: {{selection_text}};
}
QTableWidget::item:hover, QTableView::item:hover {
    background-color: {{surface_alt}};
}

/* --- TABS --- */
QTabWidget::pane {
    border: 1px solid {{border}};
    border-radius: 8px;
    background-color: {{surface}};
    padding: 16px;
    top: -1px; 
}

QTabBar::tab {
    background: {{surface_alt}};
    color: {{foreground_muted}};
    padding: 8px 16px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border: 1px solid {{border}};
    border-bottom: none;
    font-weight: 500;
}

QTabBar::tab:selected {
    background: {{surface}};
    color: {{primary}};
    border: 1px solid {{border}};
    border-bottom: 2px solid {{primary}};
}

QTabBar::tab:hover:!selected {
    background: {{border}};
    color: {{foreground}};
}

/* --- SCROLLBARS (Modern) --- */
QScrollBar:vertical {
    border: none;
    background: {{background}};
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: {{border}};
    min-height: 20px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: {{foreground_muted}};
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}